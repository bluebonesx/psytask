{
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/bun": "^1.3.4",
    "@types/node": "^22.19.3",
    "esbuild": "^0.27.1",
    "estree-walker": "^3.0.3",
    "ignore": "^7.0.5",
    "magic-string": "^0.30.21",
    "prettier": "^3.7.4",
    "prettier-plugin-jsdoc": "^1.8.0",
    "rollup": "^4.53.5",
    "rollup-plugin-dts": "^6.3.0",
    "shared": "workspace:*",
    "typedoc": "^0.28.15",
    "typedoc-github-theme": "^0.3.1",
    "typedoc-plugin-mdn-links": "^5.0.10"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-jsdoc"
    ],
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "tsdoc": true
  },
  "scripts": {
    "docs": "typedoc --options typedoc.json",
    "dev": "bun scripts/dev.ts --dev",
    "build": "bun scripts/build.ts",
    "publish": "bun scripts/publish.ts",
    "e2e": "bun scripts/e2e.ts",
    "format": "prettier --write . --ignore-path **/dist/**"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "shared"
    ],
    "catalog": {
      "playwright": "^1.57.0",
      "jspsych": "^8.2.2",
      "vanjs-core": "1.6.0",
      "vanjs-ext": "0.6.3"
    }
  }
}
