{
  "version": "1.0.0",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "publish": "bun scripts/publish.ts",
    "format": "prettier --write . --ignore-path **/dist/**"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "vanjs-core": "^1.6.0",
    "vanjs-ext": "^0.6.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/node": "^22.18.11",
    "ignore": "^7.0.5",
    "monaco-editor": "^0.53.0",
    "prettier": "^3.6.2",
    "prettier-plugin-jsdoc": "^1.3.3",
    "typedoc": "^0.28.12"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-jsdoc"
    ],
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "tsdoc": true
  }
}
