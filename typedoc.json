{
  "entryPoints": ["packages/*"],
  "exclude": ["packages/create-psytask"],
  "entryPointStrategy": "packages",
  "categorizeByGroup": false,
  "packageOptions": {
    "entryPoints": ["index.ts"],
    "skipErrorChecking": true
  },
  "name": "PsyTask | API Docs",
  "out": "dist",
  "includeVersion": true,
  "useTsLinkResolution": true,
  "maxTypeConversionDepth": 3,
  "externalSymbolLinkMappings": {
    "typescript": {
      "devicePixelRatio": "https://developer.mozilla.org/docs/Web/API/Window/devicePixelRatio",
      "innerWidth": "https://developer.mozilla.org/docs/Web/API/Window/innerWidth",
      "Disposable": "https://developer.mozilla.org/docs/Web/JavaScript/Reference/Global_Objects/Symbol/dispose",
      "localStorage": "https://developer.mozilla.org/docs/Web/API/Window/localStorage"
    }
  },
  "plugin": ["typedoc-plugin-mdn-links", "typedoc-github-theme"]
  // "theme": "fresh"
}
